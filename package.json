{
  "name": "corte-certo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"node --watch server/index.mjs\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "db:migrate": "node server/migrate.mjs",
    "db:admin": "node server/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/*.integration.mjs",
    "db:backup": "node server/backup.mjs"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.49.0",
    "mysql2": "^3.24.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
